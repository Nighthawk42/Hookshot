<Window x:Class="HookshotBuilder.Launcher.LauncherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hookshot" Width="1100" Height="700" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="#0A1410" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="{StaticResource Ui}">

  <Window.Resources>
    <ResourceDictionary Source="Theme.xaml"/>
  </Window.Resources>

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Grid x:Name="Root">
    <!-- ===== the night: the forest (Images/launcher-forest.jpg, made for Hookshot with Anima on a local sd-server), a shade over it
         for the text (light on Adventure, deeper behind the settings), a darker foot, fireflies ===== -->
    <Image x:Name="Backdrop" Source="pack://application:,,,/Images/launcher-forest.jpg" Stretch="UniformToFill" IsHitTestVisible="False"
           RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.7,0.5">
      <Image.RenderTransform><ScaleTransform x:Name="Drift"/></Image.RenderTransform>
    </Image>
    <Rectangle x:Name="PageShade" IsHitTestVisible="False" Opacity="0.35">
      <Rectangle.Fill>
        <RadialGradientBrush Center="0.6,0.42" GradientOrigin="0.6,0.42" RadiusX="0.55" RadiusY="0.6">
          <GradientStop Color="#F00A1410" Offset="0"/>
          <GradientStop Color="#B00A1410" Offset="0.7"/>
          <GradientStop Color="#900A1410" Offset="1"/>
        </RadialGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#00050A08" Offset="0.55"/>
          <GradientStop Color="#CC050A08" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <Canvas x:Name="Fireflies" IsHitTestVisible="False" ClipToBounds="True"/>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="252"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== the side: the emblem, the pages, the version ===== -->
      <Border Background="#D408100D" BorderBrush="{StaticResource ZGoldLine}" BorderThickness="0,0,1,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" Margin="0,34,0,0" HorizontalAlignment="Center">
            <Grid Width="84" Height="84" HorizontalAlignment="Center">
              <Ellipse>
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#55D9B45A" Offset="0"/>
                    <GradientStop Color="#00D9B45A" Offset="1"/>
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Ellipse Stroke="{StaticResource ZGoldDim}" StrokeThickness="1" Margin="6"/>
              <Ellipse Stroke="{StaticResource ZGoldLine}" StrokeThickness="1" Margin="10" StrokeDashArray="2 3"/>
              <Image Source="pack://application:,,,/Images/hookshot.png" Width="50" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="3" Direction="270" Opacity="0.6" Color="Black"/></Image.Effect>
              </Image>
            </Grid>
            <TextBlock Text="HOOKSHOT" FontFamily="{StaticResource ZDisplay}" FontWeight="Bold" FontSize="22" Foreground="{StaticResource ZGold}"
                       HorizontalAlignment="Center" Margin="0,14,0,0"/>
            <TextBlock Text="Ocarina of Time on PC" Style="{StaticResource ZFaint}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom" Margin="26,0,22,24">
            <Grid Margin="0,0,0,12">
              <Rectangle Height="1" Fill="{StaticResource ZGoldLine}" VerticalAlignment="Center"/>
            </Grid>
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource ZInkFaint}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <TextBlock x:Name="RailVersion" Text="Hookshot" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource ZInkSoft}"/>
            </StackPanel>
            <TextBlock x:Name="RailStatus" Style="{StaticResource ZFaint}" Text="Checking for updates…" Margin="15,3,0,0"/>
          </StackPanel>

          <StackPanel x:Name="Nav" Margin="0,30,0,0">
            <RadioButton x:Name="NavHome" Style="{StaticResource ZNav}" Content="Adventure" IsChecked="True" Checked="NavChanged"
                         Tag="M12,0 L14,3 L14,14 L17,14 L17,16 L14,16 L14,19 L15.5,20.5 L15.5,22 L8.5,22 L8.5,20.5 L10,19 L10,16 L7,16 L7,14 L10,14 L10,3 Z"/>
            <RadioButton x:Name="NavGraphics" Style="{StaticResource ZNav}" Content="Graphics" Checked="NavChanged"
                         Tag="M12,0 L19,5 L19,17 L12,22 L5,17 L5,5 Z M12,4 L9,7 L9,15 L12,18 L15,15 L15,7 Z"/>
            <RadioButton x:Name="NavGameplay" Style="{StaticResource ZNav}" Content="Gameplay" Checked="NavChanged"
                         Tag="M12,21 L3.2,12.2 C0.8,9.8 1.4,5.4 4.6,4.2 C7.2,3.2 9.8,4.4 12,7 C14.2,4.4 16.8,3.2 19.4,4.2 C22.6,5.4 23.2,9.8 20.8,12.2 Z"/>
            <RadioButton x:Name="NavControls" Style="{StaticResource ZNav}" Content="Controls" Checked="NavChanged"
                         Tag="M7,5 L17,5 C21,5 23,9 23,13 C23,17 21,19 19,19 C17,19 16,16 15,15 L9,15 C8,16 7,19 5,19 C3,19 1,17 1,13 C1,9 3,5 7,5 Z M5,9 L5,11 L3,11 L3,13 L5,13 L5,15 L7,15 L7,13 L9,13 L9,11 L7,11 L7,9 Z M17,9 A1.2,1.2 0 1 0 17.01,9 Z M19.5,11.5 A1.2,1.2 0 1 0 19.51,11.5 Z"/>
            <RadioButton x:Name="NavSystem" Style="{StaticResource ZNav}" Content="System" Checked="NavChanged"
                         Tag="M12,0 L22,4 L22,11 C22,17 17.5,21 12,23 C6.5,21 2,17 2,11 L2,4 Z M12,4 L6,6.5 L6,11 C6,14.5 8.5,17 12,18.6 C15.5,17 18,14.5 18,11 L18,6.5 Z"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <!-- ===== the page ===== -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="96"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="84"/>
        </Grid.RowDefinitions>

        <StackPanel x:Name="Header" Margin="48,34,48,0" Visibility="Collapsed">
          <TextBlock x:Name="PageTitle" Style="{StaticResource ZTitle}" Text="Graphics"/>
          <Grid Margin="0,10,0,0" HorizontalAlignment="Left" Width="300">
            <Rectangle Height="1" VerticalAlignment="Center">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                  <GradientStop Color="#FFD9B45A" Offset="0"/>
                  <GradientStop Color="#00D9B45A" Offset="1"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Path Data="M4,0 L8,4 L4,8 L0,4 Z" Fill="{StaticResource ZGold}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
          </Grid>
        </StackPanel>

        <!-- Adventure: the title, Play, what is set -->
        <Grid x:Name="HomePage" Grid.Row="0" Grid.RowSpan="2">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0">
            <TextBlock x:Name="Eyebrow" Style="{StaticResource ZEyebrow}" FontSize="13" HorizontalAlignment="Center" Foreground="{StaticResource ZGold}"/>
            <TextBlock Text="Ocarina of Time" FontFamily="{StaticResource ZDisplay}" FontWeight="Bold" FontSize="50" Foreground="{StaticResource ZInk}"
                       HorizontalAlignment="Center" Margin="0,6,0,0">
              <TextBlock.Effect><DropShadowEffect Color="#D9B45A" BlurRadius="28" ShadowDepth="0" Opacity="0.35"/></TextBlock.Effect>
            </TextBlock>
            <!-- the rule under the title: lines that fade out from a diamond -->
            <Grid Width="340" Height="14" Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Rectangle Height="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00D9B45A" Offset="0"/>
                    <GradientStop Color="#FFD9B45A" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Path Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{StaticResource ZGoldDim}" VerticalAlignment="Center"/>
                <Path Data="M7,0 L14,7 L7,14 L0,7 Z" Fill="{StaticResource ZGoldLeaf}" Margin="6,0"/>
                <Path Data="M3,0 L6,3 L3,6 L0,3 Z" Fill="{StaticResource ZGoldDim}" VerticalAlignment="Center"/>
              </StackPanel>
              <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center" Margin="8,0,0,0">
                <Rectangle.Fill>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#FFD9B45A" Offset="0"/>
                    <GradientStop Color="#00D9B45A" Offset="1"/>
                  </LinearGradientBrush>
                </Rectangle.Fill>
              </Rectangle>
            </Grid>
            <TextBlock x:Name="HomeStatus" Style="{StaticResource ZSoft}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,16,0,0"
                       Text="Checking for updates…"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
              <Button x:Name="UpdateButton" Style="{StaticResource ZUpdate}" Margin="0,0,14,0" Visibility="Collapsed" Click="UpdateClick">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M7,0 L7,10 M2,6 L7,11 L12,6 M0,14 L14,14" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                        StrokeThickness="1.8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock x:Name="UpdateText" Text="Update" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </StackPanel>
              </Button>
              <Button x:Name="HomePlay" Style="{StaticResource ZPlay}" Click="PlayClick" AutomationProperties.Name="Play">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M0,0 L13,8 L0,16 Z" Fill="#2A1E06" VerticalAlignment="Center" Margin="0,0,14,0"/>
                  <TextBlock Text="Play" FontFamily="{StaticResource ZDisplay}" FontWeight="Bold" FontSize="20" Foreground="#2A1E06"/>
                </StackPanel>
              </Button>
            </StackPanel>

            <UniformGrid x:Name="Summary" Columns="3" Margin="0,40,0,0" Width="640"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
              <Button Style="{StaticResource ZLink}" Content="Open the game folder" Click="OpenFolderClick"/>
              <TextBlock Text="  ◆  " FontSize="8" Foreground="{StaticResource ZGoldDim}" VerticalAlignment="Center"/>
              <Button Style="{StaticResource ZLink}" Content="Saves" Click="OpenSavesClick"/>
              <TextBlock Text="  ◆  " FontSize="8" Foreground="{StaticResource ZGoldDim}" VerticalAlignment="Center"/>
              <Button Style="{StaticResource ZLink}" Content="Last run's log" Click="OpenLogClick"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <ScrollViewer x:Name="GraphicsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="48,8,40,16" Focusable="False">
          <StackPanel x:Name="GraphicsRows"/>
        </ScrollViewer>

        <ScrollViewer x:Name="GameplayPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="48,8,40,16" Focusable="False">
          <StackPanel x:Name="GameplayRows"/>
        </ScrollViewer>

        <ScrollViewer x:Name="ControlsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="48,8,40,16" Focusable="False">
          <StackPanel>
            <StackPanel x:Name="ControlsRows"/>
            <Grid Margin="0,30,0,4">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Style="{StaticResource ZEyebrow}" FontSize="15" Foreground="{StaticResource ZGold}" Text="BUTTON MAPPING"/>
                <TextBlock x:Name="BindHint" Style="{StaticResource ZFaint}" Margin="0,4,0,0"
                           Text="Click a box, then press the button or key. Esc cancels, Delete clears it. Right-click a controller box to pick from a list."/>
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource ZOutline}" Content="Reset controls" Click="ResetControlsClick" VerticalAlignment="Bottom"/>
            </Grid>
            <Grid Margin="0,14,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="12"/>
                <ColumnDefinition Width="150"/><ColumnDefinition Width="12"/><ColumnDefinition Width="150"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource ZEyebrow}" Text="SWITCH BUTTON"/>
              <TextBlock Grid.Column="1" Style="{StaticResource ZEyebrow}" Text="CONTROLLER"/>
              <TextBlock Grid.Column="3" Style="{StaticResource ZEyebrow}" Text="KEY"/>
              <TextBlock Grid.Column="5" Style="{StaticResource ZEyebrow}" Text="SECOND KEY"/>
            </Grid>
            <StackPanel x:Name="BindRows"/>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SystemPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Padding="48,8,40,16" Focusable="False">
          <StackPanel x:Name="SystemRows"/>
        </ScrollViewer>

        <!-- ===== the foot: what was saved, the running game, Play ===== -->
        <Border Grid.Row="2" BorderBrush="{StaticResource ZGoldLine}" BorderThickness="0,1,0,0" Background="#80060C09">
          <Grid Margin="48,0,40,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Path x:Name="SaveMark" Data="M5,0 L10,5 L5,10 L0,5 Z" Fill="{StaticResource ZGoldDim}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <TextBlock x:Name="SaveState" Style="{StaticResource ZSoft}" VerticalAlignment="Center" TextWrapping="NoWrap"
                         Text="Settings are saved to hookshot_options.ini as you change them."/>
            </StackPanel>
            <Button x:Name="FootPlay" Grid.Column="1" Style="{StaticResource ZPlay}" Height="46" MinWidth="170" FontSize="17" Click="PlayClick"
                    AutomationProperties.Name="Play" Visibility="Collapsed">
              <StackPanel Orientation="Horizontal">
                <Path Data="M0,0 L11,7 L0,14 Z" Fill="#2A1E06" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="Play" FontFamily="{StaticResource ZDisplay}" FontWeight="Bold" FontSize="17" Foreground="#2A1E06"/>
              </StackPanel>
            </Button>
          </Grid>
        </Border>
      </Grid>
    </Grid>

    <!-- the window's own buttons -->
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Panel.ZIndex="9"
                WindowChrome.IsHitTestVisibleInChrome="True">
      <Button Style="{StaticResource Caption}" Click="MinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize">
        <Rectangle Width="10" Height="1" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
      <Button Style="{StaticResource Caption}" Click="CloseClick" ToolTip="Close" AutomationProperties.Name="Close">
        <Path Data="M0,0 L10,10 M10,0 L0,10" StrokeThickness="1.2" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
      </Button>
    </StackPanel>

    <!-- the frame: a gold hairline round the window -->
    <Border BorderBrush="{StaticResource ZGoldLine}" BorderThickness="1" IsHitTestVisible="False" Panel.ZIndex="10"/>
  </Grid>
</Window>
